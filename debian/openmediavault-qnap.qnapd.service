[Unit]
Description=QNAP fan and front panel daemon (openmediavault-qnap)
Documentation=https://github.com/nader-eloshaiker/omv-qnap-plugin
After=systemd-modules-load.service
ConditionPathExists=/etc/qnapd/qnapd.json
# Never give up: every Apply restarts the daemon, and a stopped daemon
# leaves the fans at full speed.
StartLimitIntervalSec=0

[Service]
Type=simple
# Blinking LEDs need the timer trigger, which is a module on Debian
# and Proxmox kernels.
ExecStartPre=-/sbin/modprobe -q ledtrig-timer
ExecStart=/usr/sbin/qnapd run
# Runs after a clean stop *and* after a crash: never leave fans slow.
ExecStopPost=/usr/sbin/qnapd failsafe
Restart=always
RestartSec=10
RuntimeDirectory=qnapd
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
