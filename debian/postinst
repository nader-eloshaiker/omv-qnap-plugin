set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

case "$1" in
    configure)
        # Activate package triggers.
        dpkg-trigger update-workbench

        # Initialize and migrate configuration database.
        echo "Updating configuration database ..."
        omv-confdbadm create "conf.service.qnap"
        if [ -n "$2" ]; then
            # omv-confdbadm only accepts PEP 440 versions, so drop a Debian
            # pre-release suffix such as 7.0~alpha2.
            omv-confdbadm migrate "conf.service.qnap" "${2%%~*}"
        fi

        # Salt notices changed states by modification time, and dpkg stamps
        # files with the changelog date, so a rebuilt package of the same
        # version would keep using salt's cached copy. Refresh the times.
        touch /srv/salt/omv/deploy/qnap/*.sls \
            /srv/salt/omv/deploy/qnap/files/* \
            /srv/salt/omv/deploy/collectd/plugins/qnap.sls || :
        omv-salt deploy run --no-color --quiet qnap || :
        # Graphs: collectd runs "qnapd collectd"; draw placeholders now.
        omv-salt deploy run --no-color --quiet collectd || :
        omv-mkrrdgraph >/dev/null 2>&1 || :
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

# Pick up a new daemon and unit file after an upgrade. dh_installsystemd
# --no-start does not reload systemd, so do it here before restarting.
if [ "$1" = "configure" ] && [ -n "$2" ]; then
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || :
    fi
    deb-systemd-invoke try-restart qnapd.service || :
fi

exit 0
