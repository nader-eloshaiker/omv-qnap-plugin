set -e

OMV_AVAILABLE=false
if [ -f /etc/default/openmediavault ] && [ -f /usr/share/openmediavault/scripts/helper-functions ]; then
    . /etc/default/openmediavault
    . /usr/share/openmediavault/scripts/helper-functions
    OMV_AVAILABLE=true
fi

case "$1" in
    purge)
        if [ "${OMV_AVAILABLE}" = "true" ]; then
            dpkg-trigger update-workbench
            # omv-confdbadm cannot be used here, the datamodel is gone.
            omv_config_delete "/config/services/qnap"
        fi
        rm -rf /etc/qnapd
        rm -f /etc/modules-load.d/openmediavault-qnap.conf \
            /etc/modprobe.d/openmediavault-qnap.conf
        if [ -f /etc/default/grub.d/openmediavault-qnap.cfg ]; then
            rm -f /etc/default/grub.d/openmediavault-qnap.cfg
            if command -v update-grub >/dev/null 2>&1; then
                update-grub || :
            fi
        fi
    ;;

    remove)
        if [ "${OMV_AVAILABLE}" = "true" ]; then
            dpkg-trigger update-workbench
        fi
    ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;

    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
