"""
qnapd - fan and front panel daemon for QNAP NAS devices.

All hardware access goes through the qnap8528 kernel driver
(https://github.com/0xGiddi/qnap8528) via sysfs, so the EC is never touched
directly and concurrent readers (the OMV UI) cannot corrupt EC transactions.

Sub-commands:
  run       Run the control loop (used by qnapd.service).
  status    Print the current readings (from the daemon, or read live).
  info      Print driver / hardware information.
  failsafe  Drive all fans to full speed (used by ExecStopPost).
  collectd  Feed the daemon's readings to collectd's exec plugin (graphs).
"""

import argparse
import collections
import glob
import json
import logging
import os
import re
import select
import signal
import socket
import statistics
import struct
import subprocess
import sys
import threading
import time

SYSFS = os.environ.get("QNAPD_SYSFS_ROOT", "/sys")
CONFIG_FILE = os.environ.get("QNAPD_CONFIG", "/etc/qnapd/qnapd.json")
STATUS_FILE = os.environ.get("QNAPD_STATUS", "/run/qnapd/status.json")
# Device identity never changes but VPD reads through the EC are slow
# (~5 ms per byte), so it is cached for the boot (/run is a tmpfs).
IDENTITY_FILE = os.environ.get("QNAPD_IDENTITY", "/run/qnapd.identity.json")
# Locate requests from the web UI: {slot id: expiry (epoch seconds)}. The RPC
# writes it; qnapd, the only hardware writer, applies it.
LOCATE_FILE = os.environ.get("QNAPD_LOCATE", "/run/qnapd/locate.json")
MOUNTS_FILE = "/proc/mounts"
INPUT_DIR = os.environ.get("QNAPD_INPUT_DIR", "/dev/input/by-path")
UPTIME_FILE = "/proc/uptime"
MODULES_DIR = os.environ.get("QNAPD_MODULES_DIR", "/lib/modules")
DRIVERS_DIR = os.environ.get("QNAPD_DRIVERS_DIR",
                             "/usr/share/openmediavault-qnap/drivers")
# qnap8528 logs the model it matched ("device model is TS-253D") but does
# not export it in sysfs. dmesg first; the journal if the ring buffer wrapped.
KERNEL_LOG_COMMANDS = (["dmesg"],
                       ["journalctl", "-k", "-b", "--no-pager", "-o", "cat"])

DRIVER = "qnap8528"
PWM_MAX = 255
# Rewrite the PWM periodically even if unchanged, in case something else
# (or an EC reset) changed it behind our back.
PWM_REFRESH_SECONDS = 60
# Never lower the PWM by more than this per control cycle.
PWM_MAX_STEP_DOWN = 16
# A PWM read back further than this from what was written is rewritten at
# once. qnap8528 stores percent (128 reads back as 127); a QM2 PIC was seen
# to ignore the first write after a daemon restart (it reported success).
PWM_READBACK_TOLERANCE = 3
# A fan reporting 0 RPM at or above this PWM for FAN_FAULT_CYCLES is failed.
FAN_FAULT_MIN_PWM = 64
FAN_FAULT_CYCLES = 3
# Lowest PWM each kind of fan gets in any mode: the restart PWM from a
# standstill plus a margin. Measured on a TS-253D (chassis fan stalls at
# 8, restarts at 32) and a QM2-2P-244A-A1 (stalls at 48, barely restarts
# at 48). See docs/PLAN.md section 5.2.
MIN_PWM_CHASSIS = 40
MIN_PWM_QM2 = 64
# The curve uses the median CPU temperature over this window, so short load
# bursts do not spin the fan up while sustained load (more than half the
# window) still does. The critical check uses raw values.
CPU_SMOOTH_SECONDS = 60
# EC temperatures outside this range are treated as junk.
PLAUSIBLE_TEMP = (5.0, 110.0)

SOURCES = ("cpu", "system", "disk", "nvme")

# Fan presets modelled on QTS "Smart Fan" modes: (low, high) degrees C per
# source, the fan starts ramping at "low" and reaches maxpwm at "high".
PRESETS = {
    "quiet": {
        "cpu": (60, 90), "system": (35, 50), "disk": (40, 50),
        "nvme": (50, 70), "pwm": (48, 200),
    },
    "normal": {
        "cpu": (55, 85), "system": (30, 45), "disk": (38, 48),
        "nvme": (45, 65), "pwm": (64, 255),
    },
    "performance": {
        "cpu": (50, 80), "system": (28, 40), "disk": (35, 45),
        "nvme": (40, 60), "pwm": (100, 255),
    },
}
# Above these temperatures the fans always run at full speed.
# QM2 card slot sensors use the NVMe limits and curve.
CRITICAL = {"cpu": 90, "system": 55, "disk": 55, "nvme": 75, "qm2": 75}

log = logging.getLogger("qnapd")


# --------------------------------------------------------------------------
# sysfs helpers
# --------------------------------------------------------------------------

def sysfs(*parts):
    return os.path.join(SYSFS, *parts)


def read(path):
    try:
        with open(path, "r") as f:
            # qnap8528's own attributes have no trailing newline; its VPD
            # strings are NUL padded.
            return f.read().replace("\0", "").strip()
    except OSError:
        return None


def read_int(path):
    value = read(path)
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def write(path, value):
    with open(path, "w") as f:
        f.write(str(value))


def find_hwmon(name):
    return [d for d in sorted(glob.glob(sysfs("class", "hwmon", "hwmon*")))
            if read(os.path.join(d, "name")) == name]


def index_of(path, prefix):
    base = os.path.basename(path)
    digits = base[len(prefix):].split("_")[0]
    return int(digits) if digits.isdigit() else 0


# --------------------------------------------------------------------------
# Configuration
# --------------------------------------------------------------------------

def to_bool(value):
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in ("1", "true", "yes", "on", "y")


def to_int(value, default):
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


HHMM = re.compile(r"^([01]?\d|2[0-3]):([0-5]\d)$")


def hhmm(value, default):
    """Minutes after midnight from "HH:MM" (default if malformed)."""
    match = HHMM.match(str(value or "")) or HHMM.match(default)
    return int(match.group(1)) * 60 + int(match.group(2))


def panel_brightness(settings, minutes):
    """Front panel brightness at a time of day (minutes after midnight):
    the night value inside the night window, which may span midnight."""
    start, end = settings.lednightstart, settings.lednightend
    if settings.lednight and start != end:
        night = start <= minutes < end if start < end else \
            minutes >= start or minutes < end
        if night:
            return settings.lednightbrightness
    return settings.ledbrightness


class Settings:
    """Typed view of conf.service.qnap as rendered by salt."""

    def __init__(self, raw=None):
        raw = raw or {}
        self.enable = to_bool(raw.get("enable", False))
        self.interval = max(2, to_int(raw.get("interval"), 10))
        self.fanmode = raw.get("fanmode", "normal")
        if self.fanmode not in ("quiet", "normal", "performance",
                                "custom", "manual"):
            self.fanmode = "normal"
        self.manualpwm = self._pwm(raw.get("manualpwm"), 160)
        self.hysteresis = max(0, to_int(raw.get("hysteresis"), 3))
        self.diskinterval = max(10, to_int(raw.get("diskinterval"), 60))
        self.ledstatus = to_bool(raw.get("ledstatus", True))
        self.leddisk = to_bool(raw.get("leddisk", True))
        self.ledbrightness = min(100, max(0, to_int(
            raw.get("ledbrightness"), 100)))
        self.volumefull = min(100, max(50, to_int(raw.get("volumefull"), 95)))
        # Rendered by salt from OMV's notification settings, not a field.
        self.notify = to_bool(raw.get("notify", False))
        self.lednight = to_bool(raw.get("lednight", False))
        self.lednightstart = hhmm(raw.get("lednightstart"), "22:00")
        self.lednightend = hhmm(raw.get("lednightend"), "07:00")
        self.lednightbrightness = min(100, max(0, to_int(
            raw.get("lednightbrightness"), 10)))
        self.beep = to_bool(raw.get("beep", False))
        # Rendered by salt from the chosen Scheduled Tasks:
        # {"script": ..., "user": ...} or absent.
        self.usbcopy = self._task(raw.get("usbcopy"))
        self.reset = self._task(raw.get("reset"))
        self.use = {src: to_bool(raw.get("use" + src, True))
                    for src in SOURCES}
        if self.fanmode in PRESETS:
            preset = PRESETS[self.fanmode]
            self.ranges = {src: preset[src] for src in SOURCES}
            self.pwm_range = preset["pwm"]
        else:
            self.ranges = {
                "cpu": (to_int(raw.get("cpulow"), 55),
                        to_int(raw.get("cpuhigh"), 85)),
                "system": (to_int(raw.get("syslow"), 30),
                           to_int(raw.get("syshigh"), 45)),
                "disk": (to_int(raw.get("disklow"), 38),
                         to_int(raw.get("diskhigh"), 48)),
                "nvme": (to_int(raw.get("nvmelow"), 45),
                         to_int(raw.get("nvmehigh"), 65)),
            }
            lo = self._pwm(raw.get("minpwm"), 64)
            hi = self._pwm(raw.get("maxpwm"), 255)
            self.pwm_range = (min(lo, hi), max(lo, hi))
        # QM2 cards: each card fan follows its own slot and NVMe sensors.
        self.use["qm2"] = to_bool(raw.get("useqm2", True))
        self.ranges["qm2"] = self.ranges["nvme"]

    @staticmethod
    def _task(value):
        if isinstance(value, dict) and isinstance(value.get("script"), str):
            return {"script": value["script"],
                    "user": str(value.get("user") or "root")}
        return None

    @staticmethod
    def _pwm(value, default):
        return min(PWM_MAX, max(0, to_int(value, default)))

    @classmethod
    def load(cls, path=None):
        path = path or CONFIG_FILE
        with open(path, "r") as f:
            return cls(json.load(f))


# --------------------------------------------------------------------------
# Hardware access
# --------------------------------------------------------------------------

class Hardware:
    def __init__(self):
        found = find_hwmon(DRIVER)
        self.ec = found[0] if found else None

    def present(self):
        return self.ec is not None

    def fans(self):
        if not self.ec:
            return []
        result = []
        for path in sorted(glob.glob(os.path.join(self.ec, "fan*_input")),
                           key=lambda p: index_of(p, "fan")):
            rpm = read_int(path)
            # The EC returns 65535 for missing or broken fans.
            if rpm is not None and rpm >= 65535:
                rpm = None
            result.append({"name": "fan%d" % index_of(path, "fan"),
                           "rpm": rpm})
        return result

    def pwm_paths(self):
        if not self.ec:
            return []
        return sorted((p for p in glob.glob(os.path.join(self.ec, "pwm*"))
                       if os.path.basename(p)[3:].isdigit()),
                      key=lambda p: index_of(p, "pwm"))

    def read_pwm(self):
        values = [read_int(p) for p in self.pwm_paths()]
        values = [v for v in values if v is not None]
        return max(values) if values else None

    def set_pwm(self, value):
        value = min(PWM_MAX, max(0, int(value)))
        for path in self.pwm_paths():
            write(path, value)

    @staticmethod
    def _temps(hwmon, prefix):
        result = []
        for path in sorted(glob.glob(os.path.join(hwmon, "temp*_input")),
                           key=lambda p: index_of(p, "temp")):
            value = read_int(path)
            if value is None:
                continue
            label = read(path.replace("_input", "_label"))
            result.append(("%s%d" % (prefix, index_of(path, "temp")),
                           label, value / 1000.0))
        return result

    def system_temps(self):
        if not self.ec:
            return []
        lo, hi = PLAUSIBLE_TEMP
        return [(name, "EC " + name, t)
                for name, _, t in self._temps(self.ec, "temp")
                if lo <= t <= hi]

    def cpu_temps(self):
        for driver in ("coretemp", "k10temp", "zenpower"):
            for hwmon in find_hwmon(driver):
                temps = self._temps(hwmon, "cpu")
                preferred = [t for t in temps
                             if t[1] in ("Package id 0", "Tctl", "Tdie")]
                temps = preferred or temps
                if temps:
                    best = max(temps, key=lambda t: t[2])
                    return [("cpu", best[1] or "CPU", best[2])]
        return []

    def nvme_temps(self, under=None):
        """NVMe temperatures, optionally only below a sysfs device path."""
        result = []
        for i, hwmon in enumerate(find_hwmon("nvme")):
            if under and not os.path.realpath(hwmon).startswith(
                    under + os.sep):
                continue
            temps = self._temps(hwmon, "t")
            # temp1 is the "Composite" temperature.
            if temps:
                result.append(("nvme%d" % i, "NVMe %d" % i, temps[0][2]))
        return result

    @staticmethod
    def qm2_cards():
        # Rediscovered on every call: qm2mod may be loaded after qnapd.
        return [Qm2Card(hwmon) for hwmon in find_hwmon("qm2")]


class Qm2Card:
    """A QM2 PCIe expansion card driven by qm2mod
    (https://github.com/0xGiddi/qnap-qm2).

    The hwmon device is a child of the card's platform device
    /sys/devices/platform/qm2.N, which holds model/serial/pic_version.
    """

    def __init__(self, hwmon):
        self.hwmon = hwmon
        self.device = os.path.realpath(os.path.join(hwmon, "device"))
        self.name = os.path.basename(self.device)

    def attr(self, name):
        return read(os.path.join(self.device, name))

    @property
    def label(self):
        """Short UI label: "QM2" for the first card, "QM2 #N" after that
        (the model name is too long for the dashboard tiles)."""
        index = self.name.rpartition(".")[2]
        return "QM2" if index in ("", "0") else "QM2 #%d" % (int(index) + 1)

    def leds(self):
        return [p for p in sorted(glob.glob(sysfs("class", "leds",
                                                  "qm2-*:*:slot*")))
                if os.path.realpath(os.path.join(p, "device")) ==
                self.device]

    def pci_path(self):
        """sysfs path of the card's PCIe switch, or None.

        qm2mod's I2C adapter is a child of the switch, and the adapter
        number is part of every slot LED name (qm2-<adapter>:<colour>:...).
        """
        for led in self.leds():
            adapter = os.path.basename(led).split(":")[0][len("qm2-"):]
            path = sysfs("bus", "i2c", "devices", "i2c-" + adapter)
            if os.path.exists(path):
                return os.path.dirname(os.path.realpath(path))
        return None

    def fan(self):
        return {"name": self.name + "-fan1",
                "rpm": read_int(os.path.join(self.hwmon, "fan1_input"))}

    def read_pwm(self):
        return read_int(os.path.join(self.hwmon, "pwm1"))

    def set_pwm(self, value):
        write(os.path.join(self.hwmon, "pwm1"),
              min(PWM_MAX, max(0, int(value))))

    def restore_default(self):
        """Hand the fan back to the card's own (PIC) controller."""
        write(os.path.join(self.device, "fan_default"), 1)

    def temps(self):
        """One sensor per M.2 slot; empty slots read implausible values."""
        lo, hi = PLAUSIBLE_TEMP
        return [("%s-slot%d" % (self.name, index_of(name, "temp")),
                 "%s slot %d" % (self.label, index_of(name, "temp")), t)
                for name, _, t in Hardware._temps(self.hwmon, "temp")
                if lo <= t <= hi]


class DiskTemps:
    """SATA/SAS disk temperatures via smartctl, cached between polls.

    Disks in standby are skipped (smartctl -n standby) so that fan control
    never spins up sleeping disks. Awake disks with no I/O since their last
    query keep their last reading: on the reference TS-253D a S.M.A.R.T.
    read restarts the drive's standby timer, so querying idle disks every
    poll kept them from ever spinning down.
    """

    # An idle, awake disk is still queried this often (health, slow drift).
    IDLE_REFRESH_SECONDS = 1800

    def __init__(self, interval):
        self.interval = interval
        self.last = None
        self.cache = []
        # Disks whose last S.M.A.R.T. overall health check failed. Disks in
        # standby keep their previous verdict.
        self.failed = set()
        self.queried = {}   # dev -> (time, I/O count) of the last query
        self.readings = {}  # dev -> last (dev, label, temperature)

    def get(self, now):
        if self.last is None or now - self.last >= self.interval:
            self.last = now
            self.cache = self.refresh(now)
        return self.cache

    @staticmethod
    def devices():
        """Internal disks only. USB disks sit outside the chassis airflow,
        so the fans cannot cool them; a USB boot SSD may also report
        itself as non-removable."""
        result = []
        for path in sorted(glob.glob(sysfs("block", "sd*"))):
            if read(os.path.join(path, "removable")) == "1":
                continue
            if re.search(r"/usb\d+/", os.path.realpath(path)):
                continue
            result.append(os.path.basename(path))
        return result

    def refresh(self, now):
        result = []
        for dev in self.devices():
            ios = io_count(dev)
            when, last_ios = self.queried.get(dev, (None, None))
            if ios is not None and ios == last_ios and \
                    now - when < self.IDLE_REFRESH_SECONDS:
                if dev in self.readings:
                    result.append(self.readings[dev])
                continue
            self.queried[dev] = (now, ios)
            self.readings.pop(dev, None)
            try:
                proc = subprocess.run(
                    ["smartctl", "-n", "standby", "-A", "-H", "-j",
                     "/dev/" + dev],
                    capture_output=True, text=True, timeout=20)
                data = json.loads(proc.stdout or "{}")
            except (OSError, subprocess.SubprocessError, ValueError):
                continue
            temp, passed = parse_smart(data)
            if temp is not None:
                self.readings[dev] = (dev, dev, temp)
                result.append(self.readings[dev])
            if passed is False:
                self.failed.add(dev)
            elif passed is True:
                self.failed.discard(dev)
        return result


def io_count(dev):
    """Reads plus writes completed by a block device, or None. S.M.A.R.T.
    queries do not count."""
    stat = (read(sysfs("block", dev, "stat")) or "").split()
    return int(stat[0]) + int(stat[4]) if len(stat) >= 5 else None


def parse_smart(data):
    """(temperature or None, health True/False/None) from smartctl -j."""
    temp = (data.get("temperature") or {}).get("current")
    temp = float(temp) if isinstance(temp, (int, float)) else None
    passed = (data.get("smart_status") or {}).get("passed")
    return temp, passed if isinstance(passed, bool) else None


def disk_name(path):
    """sda for /dev/sda1, nvme0n1 for /dev/nvme0n1p1."""
    match = re.match(r"(nvme\d+n\d+|[a-z]+?d[a-z]+)",
                     os.path.basename(path))
    return match.group(1) if match else None


def zfs_faulted(text):
    """Disks that are not ONLINE, or have read/write/checksum errors, in
    `zpool status -LP` output."""
    result = set()
    for line in text.splitlines():
        fields = line.split()
        if len(fields) >= 5 and fields[0].startswith("/dev/"):
            state, counters = fields[1], fields[2:5]
            if state != "ONLINE" or any(c != "0" for c in counters):
                name = disk_name(fields[0])
                if name:
                    result.add(name)
    return result


def md_faulty(text):
    """Disks marked faulty (F) in /proc/mdstat."""
    return {disk_name(m) for m in re.findall(r"(\w+)\[\d+\]\(F\)", text)
            if disk_name(m)}


def nvme_failed():
    """NVMe namespaces (nvme0n1) whose controller fails S.M.A.R.T. health
    (critical warning set). NVMe SSDs do not spin down, so this is safe."""
    result = set()
    for block in sorted(glob.glob(sysfs("block", "nvme*n*"))):
        name = os.path.basename(block)
        controller = re.match(r"nvme\d+", name).group(0)
        try:
            proc = subprocess.run(["smartctl", "-H", "-j", "/dev/" + controller],
                                  capture_output=True, text=True, timeout=20)
            _, passed = parse_smart(json.loads(proc.stdout or "{}"))
        except (OSError, subprocess.SubprocessError, ValueError):
            continue
        if passed is False:
            result.add(name)
    return result


def zfs_pools(list_text, status_text):
    """{pool: (health, capacity %, resilvering)} from `zpool list -H -o
    name,health,cap` and `zpool status`. A scrub is routine maintenance and
    does not count."""
    pools = {}
    for line in list_text.splitlines():
        fields = line.split()
        if len(fields) >= 3:
            pools[fields[0]] = [fields[1], to_int(fields[2].rstrip("%"), 0),
                                False]
    pool = None
    for line in status_text.splitlines():
        match = re.match(r"\s*pool:\s*(\S+)", line)
        if match:
            pool = match.group(1)
        elif pool in pools and re.match(r"\s*scan:\s*resilver in progress",
                                        line):
            pools[pool][2] = True
    return {name: tuple(v) for name, v in pools.items()}


def md_arrays(text):
    """{array: (degraded, rebuilding)} from /proc/mdstat. A rebuild, resync
    or reshape counts; a check (md's scrub) does not."""
    arrays = {}
    array = None
    for line in text.splitlines():
        match = re.match(r"(md\S*)\s*:", line)
        if match:
            array = match.group(1)
            arrays[array] = [False, False]
        elif array:
            if re.search(r"\[U*_[U_]*\]", line):
                arrays[array][0] = True
            if re.search(r"\b(recovery|resync|reshape)\s*=", line):
                arrays[array][1] = True
    return {name: tuple(v) for name, v in arrays.items()}


# Local filesystems checked for "volume full"; ZFS comes from zpool list.
FULL_FS_TYPES = ("ext2", "ext3", "ext4", "xfs", "btrfs", "jfs", "f2fs")


def volume_usage(mounts_text):
    """{mount point: used %} for local block filesystems, one per device.
    statvfs is answered from the in-memory superblock: no disk I/O."""
    usage, seen = {}, set()
    for line in mounts_text.splitlines():
        fields = line.split()
        if len(fields) < 3 or fields[2] not in FULL_FS_TYPES or \
                not fields[0].startswith("/dev/") or fields[0] in seen:
            continue
        seen.add(fields[0])
        mount = fields[1].replace("\\040", " ")
        try:
            st = os.statvfs(mount)
        except OSError:
            continue
        used = st.f_blocks - st.f_bfree
        if used + st.f_bavail > 0:
            usage[mount] = int(round(100.0 * used / (used + st.f_bavail)))
    return usage


def storage_state(pools, arrays, usage, full):
    """(state, reasons) for the status LED, QTS style: "fault" (solid red)
    for a failed pool or a volume at least `full` % used, "degraded" (red
    blink), "rebuilding" (green/red), or "ok". The worst wins."""
    found = {}
    for name, (health, cap, resilvering) in sorted(pools.items()):
        if health in ("FAULTED", "UNAVAIL", "SUSPENDED"):
            found.setdefault("fault", []).append("%s %s" % (name, health))
        elif resilvering:
            found.setdefault("rebuilding", []).append(name + " resilvering")
        elif health != "ONLINE":
            found.setdefault("degraded", []).append("%s %s" % (name, health))
        if cap >= full:
            found.setdefault("fault", []).append("%s %d%% full" % (name, cap))
    for name, (degraded, rebuilding) in sorted(arrays.items()):
        if rebuilding:
            found.setdefault("rebuilding", []).append(name + " rebuilding")
        elif degraded:
            found.setdefault("degraded", []).append(name + " degraded")
    for mount, used in sorted(usage.items()):
        if used >= full:
            found.setdefault("fault", []).append("%s %d%% full" % (mount,
                                                                 used))
    for state in ("fault", "degraded", "rebuilding"):
        if state in found:
            return state, [r for s in ("fault", "degraded", "rebuilding")
                           for r in found.get(s, [])]
    return "ok", []


def command_output(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return ""  # e.g. no ZFS.


def storage_health(full):
    """(faulted disks, LED state, reasons) from ZFS pools, md arrays, NVMe
    health and filesystem usage. All read in-kernel or controller state, so
    sleeping disks are not woken."""
    mdstat = read("/proc/mdstat") or ""
    zstatus = command_output(["zpool", "status", "-LP"])
    zlist = command_output(["zpool", "list", "-H", "-o", "name,health,cap"])
    faulted = md_faulty(mdstat) | nvme_failed() | zfs_faulted(zstatus)
    state, reasons = storage_state(zfs_pools(zlist, zstatus),
                                   md_arrays(mdstat),
                                   volume_usage(read(MOUNTS_FILE) or ""),
                                   full)
    return faulted, state, reasons


PCI_ADDRESS = re.compile(r"^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$")


def pci_children(path):
    return sorted(d for d in os.listdir(path) if PCI_ADDRESS.match(d)) \
        if os.path.isdir(path) else []


def qm2_swapped(card):
    """qm2mod corrects generic QM2-2P cards whose slots 1/2 are wired the
    other way round; it only says so in the kernel log (swap=1)."""
    serial = card.attr("serial") or ""
    for cmd in KERNEL_LOG_COMMANDS:
        try:
            out = subprocess.run(cmd, capture_output=True, text=True,
                                 timeout=10).stdout
        except (OSError, subprocess.SubprocessError):
            continue
        found = re.findall(r"qm2_identify_card: Card: \S+ serial=%s .*"
                           r"swap=(\d)" % re.escape(serial), out)
        if found:
            return found[-1] == "1"
    return False


def qm2_slot_disks(card, swapped=False):
    """[nvme block device or None] per M.2 slot of a QM2 card, in slot order.

    Slots are the card switch's downstream ports that hold an NVMe SSD or
    nothing (ports with a NIC behind them are skipped), in PCI order.
    Verified on a QM2-2P-244A-A1 (ports 02:00.0 and 02:08.0 = slots 1, 2).
    """
    pci = card.pci_path()
    if not pci:
        return []
    disks = {}
    for block in glob.glob(sysfs("block", "nvme*n*")):
        real = os.path.realpath(block)
        if real.startswith(pci + os.sep):
            port = real[len(pci) + 1:].split(os.sep)[0]
            disks.setdefault(port, os.path.basename(block))
    slots = []
    for port in pci_children(pci):
        children = pci_children(os.path.join(pci, port))
        classes = [read(os.path.join(pci, port, c, "class")) or ""
                   for c in children]
        if all(c.startswith("0x0108") for c in classes):  # NVMe or empty
            slots.append(disks.get(port))
    if swapped and len(slots) >= 2:
        slots[0], slots[1] = slots[1], slots[0]
    return slots


# Models whose bay LEDs blink in EC hardware (qnap8528 "has_active"),
# verified on the box. On other models a blink request makes the kernel
# fall back to software blinking: one EC write every ~100 ms per LED, which
# floods the EC lock that fan control also needs (e.g. TS-877: only its
# M.2 LEDs blink in hardware). Bays there show present/error only.
HW_ACTIVITY_BLINK_MODELS = ("TS-253D",)


class DiskLeds:
    """Disk LEDs, QTS style: green when a disk is present, blinking green
    on I/O, red when S.M.A.R.T. fails or a ZFS/md array has faulted the
    disk, off for an empty slot.

    - Bays (qnap8528::hddN, 0 off / 1 green / 2 red): bay N is the disk on
      SATA port N (ataN), so it survives sdX renaming (verified on a
      TS-253D: hdd1 = ata1, hdd2 = ata2). Blinks in hardware.
    - QM2 card slots (qm2-<i2c>:{green,red}:slotN, separate LEDs): slot N
      from qm2_slot_disks(). The green LED cannot blink by itself, so the
      kernel's timer trigger toggles it over the card's I2C bus.

    Activity comes from /sys/block/<disk>/stat, which never wakes a sleeping
    disk. A thread polls it and is the only writer of these LEDs.
    """

    POLL_SECONDS = 0.25
    # Keep blinking this long after the last I/O, so short bursts show.
    ACTIVE_HOLD_SECONDS = 1.0
    # Inside qnap8528's hardware blink window for disk LEDs (80-140 ms).
    BLINK_MS = 100

    def __init__(self, bay_activity=False):
        # Blink bays on I/O; only for HW_ACTIVITY_BLINK_MODELS (see there).
        self.bay_activity = bay_activity
        self.slots = []
        self.errors = set()
        self.counters = {}
        self.last_io = {}
        self.shown = {}
        self.swapped = {}
        self.locate_cache = (None, {})
        self.stop = threading.Event()
        self.thread = None
        self.discover()

    def discover(self):
        """[(kind, leds, disk, id)]; kind "bay" has (led,), "qm2" (green,
        red); id is "bayN" or "<card>-slotN" (used by locate)."""
        slots = []
        for led in sorted(glob.glob(sysfs("class", "leds", DRIVER + "::hdd*")),
                          key=lambda p: index_of(p, DRIVER + "::hdd")):
            port = index_of(led, DRIVER + "::hdd")
            slots.append(("bay", (led,), self.disk_on_port(port),
                          "bay%d" % port))
        for card in Hardware.qm2_cards():
            if card.name not in self.swapped:
                self.swapped[card.name] = qm2_swapped(card)
            leds = {os.path.basename(p): p for p in card.leds()}
            prefix = next((n.split(":")[0] for n in leds), None)
            for n, disk in enumerate(
                    qm2_slot_disks(card, self.swapped[card.name]), 1):
                green = leds.get("%s:green:slot%d" % (prefix, n))
                red = leds.get("%s:red:slot%d" % (prefix, n))
                if green and red:
                    slots.append(("qm2", (green, red), disk,
                                  "%s-slot%d" % (card.name, n)))
        self.slots = slots

    @staticmethod
    def disk_on_port(port):
        marker = "%sata%d%s" % (os.sep, port, os.sep)
        for block in sorted(glob.glob(sysfs("block", "sd*"))):
            if marker in os.path.realpath(block):
                return os.path.basename(block)
        return None

    def update(self, errors):
        """Called from the control loop: rediscover slots (hot swap) and set
        the disks to show as failed."""
        self.discover()
        self.errors = set(errors)

    def locate_requests(self):
        """{slot id: expiry} from LOCATE_FILE, re-read when it changes."""
        try:
            mtime = os.stat(LOCATE_FILE).st_mtime
        except OSError:
            self.locate_cache = (None, {})
            return {}
        if mtime != self.locate_cache[0]:
            try:
                with open(LOCATE_FILE) as f:
                    data = json.load(f)
                requests = {str(k): float(v) for k, v in data.items()}
            except (OSError, ValueError, TypeError, AttributeError):
                requests = {}
            self.locate_cache = (mtime, requests)
        return self.locate_cache[1]

    def locating(self):
        """{slot id: expiry} still running (wall-clock expiry)."""
        wall = time.time()
        return {k: v for k, v in self.locate_requests().items() if v > wall}

    def state(self, dev, now, locate=False):
        if locate:
            return "locate"
        if dev is None:
            return "off"
        if dev in self.errors:
            return "error"
        stat = (read(sysfs("block", dev, "stat")) or "").split()
        if len(stat) >= 9:
            ios = int(stat[0]) + int(stat[4])
            if self.counters.get(dev) not in (None, ios) or stat[8] != "0":
                self.last_io[dev] = now
            self.counters[dev] = ios
        if now - self.last_io.get(dev, -1e9) < self.ACTIVE_HOLD_SECONDS:
            return "active"
        return "on"

    def blink(self, led):
        write(os.path.join(led, "trigger"), "timer")
        for name in ("delay_on", "delay_off"):
            path = os.path.join(led, name)
            if os.path.exists(path):
                write(path, self.BLINK_MS)

    def show(self, kind, leds, state):
        for led in leds:
            write(os.path.join(led, "trigger"), "none")
        if kind == "bay":
            led, = leds
            write(os.path.join(led, "brightness"),
                  {"off": 0, "on": 1, "active": 1, "error": 2,
                   "locate": 2}[state])
            if state in ("active", "locate"):  # Locate = blinking red.
                self.blink(led)
            return
        green, red = leds
        # qm2mod's red 2 (PIC blink) stays dark on the QM2-2P-244A-A1, so
        # Locate blinks red 1 with the timer trigger, like activity.
        write(os.path.join(red, "brightness"),
              1 if state in ("error", "locate") else 0)
        write(os.path.join(green, "brightness"),
              1 if state in ("on", "active") else 0)
        if state == "active":
            self.blink(green)
        elif state == "locate":
            self.blink(red)

    def poll(self, now=None):
        now = time.monotonic() if now is None else now
        locating = self.locating()
        for kind, leds, dev, slot in self.slots:
            state = self.state(dev, now, slot in locating)
            if state == "active" and kind == "bay" and not self.bay_activity:
                state = "on"
            if self.shown.get(leds) == state:
                continue
            try:
                self.show(kind, leds, state)
                self.shown[leds] = state
            except OSError as e:
                if state == "active":
                    # No timer trigger: stay solid green.
                    self.shown[leds] = state
                else:
                    log.warning("Cannot set %s: %s", leds[0], e)

    def snapshot(self):
        """Slots for the status file and the Disks page."""
        locating = self.locating()
        result = []
        for kind, leds, dev, slot in list(self.slots):
            n = slot.rsplit("slot", 1)[-1] if kind == "qm2" else slot[3:]
            card = slot.split("-slot")[0] if kind == "qm2" else None
            sectors = read(sysfs("block", dev, "size")) if dev else None
            result.append({
                "id": slot,
                "label": ("Bay %s" % n) if kind == "bay" else
                         ("%s slot %s" % (card, n)),
                "device": dev or "",
                "model": (read(sysfs("block", dev, "device", "model")) or
                          read(sysfs("block", dev, "device", "device",
                                     "model")) or "") if dev else "",
                "size_gb": round(int(sectors) * 512 / 1e9)
                           if sectors and sectors.isdigit() else None,
                "state": self.shown.get(leds, "off"),
                "locate": slot in locating,
                "locate_until": int(locating[slot]) if slot in locating
                                else None,
            })
        return result

    def start(self):
        def loop():
            while not self.stop.wait(self.POLL_SECONDS):
                try:
                    self.poll()
                except Exception:
                    log.exception("Disk LED update failed")
        self.thread = threading.Thread(target=loop, name="disk-leds",
                                       daemon=True)
        self.thread.start()

    def finish(self):
        """Stop blinking and leave the present/error colours."""
        self.stop.set()
        if self.thread:
            self.thread.join(2)
        now = time.monotonic()
        for kind, leds, dev, _ in self.slots:
            state = self.state(dev, now)
            try:
                self.show(kind, leds, "on" if state == "active" else state)
            except OSError:
                pass


def send_mail(subject, body):
    """Mail root; OMV's postfix forwards it to the notification address."""
    message = "To: root\nSubject: %s\n\n%s\n" % (subject, body)
    try:
        subprocess.run(["/usr/sbin/sendmail", "-t"], input=message, text=True,
                       capture_output=True, timeout=30, check=True)
    except (OSError, subprocess.SubprocessError) as e:
        log.warning("Cannot send notification: %s", e)


class Notifier:
    """Mails when hardware problems appear and when they clear, if OMV
    notifications are on for "QNAP hardware". A problem must last
    HOLD_SECONDS first, so a one-off glitch does not send mail."""

    HOLD_SECONDS = 60

    def __init__(self, enabled):
        self.enabled = enabled
        self.first_seen = {}
        self.reported = set()

    def update(self, problems, now):
        problems = set(problems)
        self.first_seen = {p: self.first_seen.get(p, now) for p in problems}
        confirmed = {p for p, t in self.first_seen.items()
                     if now - t >= self.HOLD_SECONDS}
        new = confirmed - self.reported
        cleared = self.reported - problems
        self.reported = (self.reported | new) - cleared
        if self.enabled and (new or cleared):
            host = socket.gethostname()
            if new:
                subject = "QNAP hardware on %s: %s" % (host, sorted(new)[0])
                if len(new) > 1:
                    subject += " (+%d more)" % (len(new) - 1)
            else:
                subject = "QNAP hardware on %s: back to normal" % host
            lines = ["New: " + p for p in sorted(new)] + \
                ["Cleared: " + p for p in sorted(cleared)] + \
                ["", "Current problems: %s" % (", ".join(sorted(
                    self.reported)) or "none"),
                 "Details: System > QNAP > Status, or `qnapd status`."]
            send_mail(subject, "\n".join(lines))
        return new, cleared


def hardware_problems(faults, reason, errors, storage):
    """Everything worth a notification, as stable short strings."""
    problems = set(faults)
    if reason and reason.startswith("critical"):
        problems.add(reason)
    problems.update("disk %s failed" % d for d in errors)
    if storage[0] != "ok":
        problems.update(storage[1])
    return problems


def status_led_state(faults, storage):
    """Fan/sensor faults and failed or full storage: solid red; a degraded
    pool or array: blinking red; a rebuild: green/red; otherwise green."""
    if faults or storage == "fault":
        return "fault"
    return {"degraded": "warning", "rebuilding": "rebuilding"}.get(storage,
                                                                  "ok")


class StatusLed:
    """Front status LED (qnap8528::status): 0 off, 1 green, 2 red."""

    STATES = {
        # state: (brightness, blink)
        "ok": (1, False),
        "starting": (1, True),
        "warning": (2, True),
        "fault": (2, False),
        # Green/red alternating (EC bicolour blink), e.g. a RAID rebuild.
        "rebuilding": (1, False),
    }

    def __init__(self, name="qnap8528::status"):
        self.path = sysfs("class", "leds", name)
        self.state = None

    def present(self):
        return os.path.isdir(self.path)

    def set(self, state):
        if state == self.state or not self.present():
            return
        brightness, blink = self.STATES[state]
        try:
            write(os.path.join(self.path, "trigger"), "none")
            # Set the colour first, then the trigger, so the EC blinks
            # the requested colour.
            write(os.path.join(self.path, "brightness"), brightness)
            self.state = state
        except OSError as e:
            log.warning("Failed to set status LED to %s: %s", state, e)
            return
        if state == "rebuilding":
            try:
                # Write-only; cancelled by the next brightness write.
                write(os.path.join(self.path, "blink_bicolor"), 1)
            except OSError:
                # blink_sw_only, or an older driver: blink red instead.
                try:
                    write(os.path.join(self.path, "brightness"), 2)
                    blink = True
                except OSError as e:
                    log.warning("Failed to set status LED: %s", e)
        if blink:
            try:
                write(os.path.join(self.path, "trigger"), "timer")
            except OSError as e:
                # The timer trigger is a module (ledtrig-timer) that
                # qnapd.service loads; without it the colour stays solid.
                log.warning("Status LED cannot blink (is ledtrig-timer "
                            "loaded?): %s", e)


def set_panel_brightness(value):
    path = sysfs("class", "leds", "qnap8528::panel_brightness", "brightness")
    if os.path.exists(path):
        try:
            write(path, value)
        except OSError as e:
            log.warning("Failed to set panel brightness: %s", e)


# --------------------------------------------------------------------------
# Buzzer, buttons and the USB LED
# --------------------------------------------------------------------------

INPUT_EVENT = struct.Struct("llHHi")  # struct input_event on 64-bit
EV_KEY, EV_SND, SND_TONE = 0x01, 0x12, 0x02
BTN_CHASSIS, BTN_RESET, BTN_USBCOPY = 256, 257, 258  # verified on a TS-253D
# OMV writes each Scheduled Task to a script named after its uuid.
TASK_SCRIPT = re.compile(r"^/var/lib/openmediavault/cron\.d/"
                         r"userdefined-[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$")


def input_device(name):
    found = sorted(glob.glob(os.path.join(INPUT_DIR, "platform-%s-event*"
                                          % name)))
    return found[0] if found else None


def uptime():
    try:
        return float((read(UPTIME_FILE) or "").split()[0])
    except (IndexError, ValueError):
        return None


class Beeper:
    """QTS buzzer patterns on the PC speaker (the buzzer is the pcspkr line
    on the TS-253D). S = short, L = long; patterns play one at a time in
    the background."""

    TONE_HZ = 1000
    SHORT, LONG, GAP = 0.5, 1.5, 0.4
    PATTERNS = {
        # No shutdown beep: OMV beeps on the way down itself.
        "startup": "S", "reset": "S",
        "usbcopy-failed": "SSS",
        "fan-failure": "LLL",
        "storage": "LL",  # degraded, or a rebuild started
    }

    def __init__(self, enabled):
        self.enabled = enabled
        self.device = input_device("pcspkr")
        self.lock = threading.Lock()

    def beep(self, event, wait=False):
        if not (self.enabled and self.device):
            return
        thread = threading.Thread(target=self.play,
                                  args=(self.PATTERNS[event],), daemon=True)
        thread.start()
        if wait:
            thread.join(10)

    def play(self, pattern):
        with self.lock:
            try:
                with open(self.device, "wb", buffering=0) as f:
                    for i, mark in enumerate(pattern):
                        if i:
                            time.sleep(self.GAP)
                        f.write(INPUT_EVENT.pack(0, 0, EV_SND, SND_TONE,
                                                 self.TONE_HZ))
                        time.sleep(self.LONG if mark == "L" else self.SHORT)
                        f.write(INPUT_EVENT.pack(0, 0, EV_SND, SND_TONE, 0))
            except OSError as e:
                log.warning("Cannot beep: %s", e)


class UsbLed:
    """Front USB LED (qnap8528::usb, blue): blinks while USB Copy runs."""

    BLINK_MS = 400  # inside the EC's hardware blink window (280-470 ms)

    def __init__(self, name="qnap8528::usb"):
        self.path = sysfs("class", "leds", name)

    def set(self, state):
        if not os.path.isdir(self.path):
            return
        try:
            write(os.path.join(self.path, "trigger"), "none")
            write(os.path.join(self.path, "brightness"),
                  0 if state == "off" else 1)
            if state == "blink":
                write(os.path.join(self.path, "trigger"), "timer")
                for name in ("delay_on", "delay_off"):
                    write(os.path.join(self.path, name), self.BLINK_MS)
        except OSError as e:
            log.warning("Failed to set USB LED: %s", e)


def run_task(task):
    """Run an OMV Scheduled Task's script as its user; True on exit 0."""
    script, user = task["script"], task.get("user") or "root"
    if not TASK_SCRIPT.match(script) or not os.access(script, os.X_OK):
        log.warning("Scheduled task %s not found; save it in OMV first",
                    script)
        return False
    cmd = [script] if user == "root" else ["runuser", "-u", user, "--",
                                           script]
    try:
        done = subprocess.run(cmd, stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL,
                              stderr=subprocess.PIPE, text=True)
    except OSError as e:
        log.warning("Cannot run %s: %s", script, e)
        return False
    if done.returncode:
        log.warning("%s exited with %d: %s", script, done.returncode,
                    done.stderr.strip()[-500:])
    return done.returncode == 0


class Buttons:
    """The qnap8528 buttons. USB Copy runs its Scheduled Task when released;
    Reset runs its task when held RESET_HOLD seconds (longer holds are
    reserved, as in QTS); chassis open is logged and mailed. One task runs
    at a time."""

    RESET_HOLD = 3
    RESET_LONG = 10
    DONE_SECONDS = 10  # USB LED solid after a successful copy

    def __init__(self, settings, beeper, usb_led=None):
        self.settings = settings
        self.beeper = beeper
        self.usb_led = usb_led or UsbLed()
        self.pressed = {}
        self.busy = threading.Lock()
        self.stop = threading.Event()
        self.thread = None

    def handle(self, code, value, now):
        """One key event (value 1 press, 0 release); returns the action."""
        if value == 1:
            self.pressed[code] = now
            if code == BTN_CHASSIS:
                log.warning("Chassis opened")
                if self.settings.notify:
                    send_mail("QNAP hardware on %s: chassis opened"
                              % socket.gethostname(),
                              "The chassis-open switch was triggered.")
                return "chassis"
            return None
        if value != 0 or code not in self.pressed:
            return None
        held = now - self.pressed.pop(code)
        if code == BTN_USBCOPY:
            log.info("USB Copy pressed")
            return self.start_task("usbcopy", self.settings.usbcopy)
        if code == BTN_RESET:
            log.info("Reset held %.1f s", held)
            if held >= self.RESET_LONG or held < self.RESET_HOLD:
                return None
            self.beeper.beep("reset")
            return self.start_task("reset", self.settings.reset)
        return None

    def start_task(self, name, task):
        if not task:
            return None
        if not self.busy.acquire(blocking=False):
            log.info("%s ignored: a button task is still running", name)
            return None
        thread = threading.Thread(target=self.run, args=(name, task),
                                  name=name, daemon=True)
        thread.start()
        return name

    def run(self, name, task):
        try:
            if name == "usbcopy":
                self.usb_led.set("blink")
            ok = run_task(task)
            log.info("%s task %s", name, "finished" if ok else "failed")
            if name == "usbcopy":
                self.usb_led.set("on" if ok else "off")
                if ok:
                    self.stop.wait(self.DONE_SECONDS)
                    self.usb_led.set("off")
                else:
                    self.beeper.beep("usbcopy-failed")
        finally:
            self.busy.release()

    def start(self):
        device = input_device(DRIVER)
        if not device:
            log.info("No %s input device: buttons not handled", DRIVER)
            return

        def loop():
            try:
                with open(device, "rb", buffering=0) as f:
                    while not self.stop.is_set():
                        if not select.select([f], [], [], 1)[0]:
                            continue
                        data = f.read(INPUT_EVENT.size)
                        if len(data) < INPUT_EVENT.size:
                            continue
                        _, _, kind, code, value = INPUT_EVENT.unpack(data)
                        if kind == EV_KEY:
                            self.handle(code, value, time.monotonic())
            except OSError as e:
                log.warning("Button input failed: %s", e)
        self.thread = threading.Thread(target=loop, name="buttons",
                                       daemon=True)
        self.thread.start()

    def finish(self):
        self.stop.set()
        if self.thread:
            self.thread.join(2)


# --------------------------------------------------------------------------
# Fan curve
# --------------------------------------------------------------------------

def demand(temp, low, high):
    """Map a temperature onto 0..1 between low and high."""
    if high <= low:
        return 1.0 if temp >= high else 0.0
    return min(1.0, max(0.0, (temp - low) / float(high - low)))


class FanCurve:
    """Linear curve driven by the hottest source relative to its range.

    Each enabled source is normalised to 0..1 against its (low, high) range
    and the maximum demand selects the PWM between minpwm and maxpwm.
    Ramping up is immediate. Ramping down waits until the source that last
    raised the fan has cooled by the hysteresis, then is rate limited.
    (Inflating every source by the hysteresis instead pinned the fan high:
    +3 C on the 10 C disk range is ~57 PWM, so disks that never raised the
    fan kept it up after a CPU burst.)
    """

    def __init__(self, settings):
        self.settings = settings
        self._hold = {}

    def target(self, readings, offset=0.0):
        level = 0.0
        for src, temps in readings.items():
            if not temps or not self.settings.use.get(src):
                continue
            low, high = self.settings.ranges[src]
            level = max(level, demand(max(temps) + offset, low, high))
        lo, hi = self.settings.pwm_range
        return int(round(lo + level * (hi - lo)))

    def critical(self, readings):
        for src, temps in readings.items():
            if temps and self.settings.use.get(src) and \
                    max(temps) >= CRITICAL[src]:
                return src
        return None

    def dominant(self, readings):
        """The enabled source with the highest demand, or None."""
        best, level = None, -1.0
        for src, temps in readings.items():
            if not temps or not self.settings.use.get(src):
                continue
            low, high = self.settings.ranges[src]
            d = demand(max(temps), low, high)
            if d > level:
                best, level = src, d
        return best

    def next_pwm(self, current, readings, hold=None):
        """Return (pwm, reason).

        hold (a dict owned by the caller, one per fan zone) remembers which
        source last raised the fan and its temperature at that time.
        """
        hold = self._hold if hold is None else hold
        src = self.critical(readings)
        if src:
            return PWM_MAX, "critical %s temperature" % src
        up = self.target(readings)
        if current is None or up > current:
            src = self.dominant(readings)
            hold.clear()
            if src:
                hold.update(source=src, temp=max(readings[src]))
            return up, "curve"
        if up == current:
            return up, "curve"
        temps = readings.get(hold.get("source"))
        if temps and max(temps) > hold["temp"] - self.settings.hysteresis:
            return current, "curve"
        return max(up, current - PWM_MAX_STEP_DOWN), "curve"


# --------------------------------------------------------------------------
# Daemon
# --------------------------------------------------------------------------

def temp_row(source, name, label, value):
    return {"type": "temperature", "source": source, "name": name,
            "label": label or name, "value": round(value, 1), "unit": "°C"}


def collect(hw, settings, disks=None, now=None):
    """Return ({source: [temps]}, [rows]) for the enabled sources."""
    now = time.monotonic() if now is None else now
    sensors = {
        "cpu": hw.cpu_temps(),
        "system": hw.system_temps(),
        "nvme": hw.nvme_temps(),
        "disk": disks.get(now) if disks else [],
    }
    readings = {src: [t for _, _, t in values]
                for src, values in sensors.items()}
    rows = [temp_row(src, name, label, t)
            for src in SOURCES for name, label, t in sensors[src]]
    return readings, rows


def collect_cards(hw):
    """Return [(card, [temps], [rows])] for every QM2 card.

    A card's temperatures are its slot sensors plus the NVMe SSDs behind
    its PCIe switch (all NVMe SSDs if the switch cannot be identified).
    """
    result = []
    for card in hw.qm2_cards():
        sensors = card.temps()
        nvme = hw.nvme_temps(under=card.pci_path())
        temps = [t for _, _, t in sensors] + [t for _, _, t in nvme]
        rows = [temp_row("qm2", name, label, t)
                for name, label, t in sensors]
        result.append((card, temps, rows))
    return result


def fan_row(source, name, label, rpm):
    return {"type": "fan", "source": source, "name": name, "label": label,
            "value": rpm if rpm is not None else "n/a", "unit": "RPM"}


def pwm_row(name, label, pwm):
    return {"type": "pwm", "source": "fan", "name": name, "label": label,
            "unit": "%", "value": int(round(pwm * 100.0 / PWM_MAX))}


def gauges(rows):
    """Flat values for the dashboard gauges: chassis and first QM2 fan duty
    (%), and the hottest temperature per source (None when absent)."""
    values = dict.fromkeys(("fanduty", "qm2duty") + SOURCES + ("qm2",))
    for row in rows:
        value = row["value"]
        if not isinstance(value, (int, float)):
            continue
        if row["type"] == "pwm":
            key = "fanduty" if row["name"] == "pwm" else "qm2duty"
            if values[key] is None:
                values[key] = value
        elif row["type"] == "temperature" and row["source"] in values:
            values[row["source"]] = max(value, values[row["source"]] or value)
    return values


def build_status(hw, rows, pwm, mode, reason, faults, running, cards=(),
                 storage=None, slots=()):
    """cards: [(Qm2Card, pwm or None)]; storage: (state, reasons)."""
    fan_rows = [fan_row("fan", f["name"], f["name"], f["rpm"])
                for f in hw.fans()]
    pwm_rows = [pwm_row("pwm", "Fan duty", pwm)] if pwm is not None else []
    for card, card_pwm in cards:
        fan_rows.append(fan_row("qm2", card.name + "-fan1",
                                card.label + " fan", card.fan()["rpm"]))
        if card_pwm is not None:
            pwm_rows.append(pwm_row(card.name + "-pwm",
                                    card.label + " duty", card_pwm))
    return {
        "timestamp": time.time(),
        "running": running,
        "gauges": gauges(fan_rows + pwm_rows + rows),
        "driver": hw.present(),
        "mode": mode,
        "pwm": pwm,
        "reason": reason,
        "faults": faults,
        "qm2": {card.name: card_pwm for card, card_pwm in cards},
        "storage": {"state": storage[0], "reasons": storage[1]}
                   if storage else None,
        "slots": list(slots),
        "rows": fan_rows + pwm_rows + rows + (
            [{"type": "storage", "source": "storage", "name": "storage",
              "label": "Storage", "unit": "",
              "value": "; ".join(storage[1]) or storage[0]}]
            if storage else []),
    }


def write_status(status):
    directory = os.path.dirname(STATUS_FILE)
    try:
        os.makedirs(directory, exist_ok=True)
        tmp = STATUS_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(status, f)
        os.replace(tmp, STATUS_FILE)
    except OSError as e:
        log.warning("Failed to write status file: %s", e)


class Zone:
    """PWM state of a set of fans driven together (chassis or a QM2 card)."""

    def __init__(self, name, floor):
        self.name = name
        self.floor = floor
        self.hold = {}
        self.pwm = None
        self.last_write = 0.0


class Daemon:
    def __init__(self, settings):
        self.settings = settings
        self.hw = Hardware()
        self.curve = FanCurve(settings)
        # Disk temperatures also carry S.M.A.R.T. health for the disk LEDs.
        self.disks = DiskTemps(settings.diskinterval) \
            if settings.use["disk"] or settings.leddisk else None
        self.disk_leds = None
        if settings.leddisk:
            model = identity().get("model")
            self.disk_leds = DiskLeds(model in HW_ACTIVITY_BLINK_MODELS)
            if model not in HW_ACTIVITY_BLINK_MODELS:
                log.info("Bay activity blink off: not verified to blink in "
                         "hardware on %s", model or "this model")
        # (last check, faulted disks, LED state, reasons), every diskinterval.
        self.storage = (None, set(), "ok", [])
        self.brightness = None  # Front panel brightness last written.
        self.notifier = Notifier(settings.notify)
        self.beeper = Beeper(settings.beep)
        self.buttons = Buttons(settings, self.beeper)
        self.fan_beep = None  # when the fan-failure alarm last sounded
        self.storage_seen = None  # storage state at the last step
        self.led = StatusLed()
        self.chassis = Zone("chassis", MIN_PWM_CHASSIS)
        self.cards = {}
        self.cpu_history = collections.deque()
        self.zero_rpm = {}
        self.stop = threading.Event()

    def check_fans(self, fans, pwm):
        faults = []
        for fan in fans:
            name = fan["name"]
            if fan["rpm"] is None or fan["rpm"] >= 65535 or \
                    (fan["rpm"] == 0 and (pwm or 0) >= FAN_FAULT_MIN_PWM):
                self.zero_rpm[name] = self.zero_rpm.get(name, 0) + 1
            else:
                self.zero_rpm[name] = 0
            if self.zero_rpm[name] >= FAN_FAULT_CYCLES:
                faults.append("%s not spinning" % name)
        return faults

    def smooth_cpu(self, readings, now):
        """Return readings with the CPU temperature replaced by its median
        over the last CPU_SMOOTH_SECONDS."""
        if not readings.get("cpu"):
            return readings
        self.cpu_history.append((now, max(readings["cpu"])))
        while self.cpu_history[0][0] < now - CPU_SMOOTH_SECONDS:
            self.cpu_history.popleft()
        smoothed = dict(readings)
        smoothed["cpu"] = [statistics.median(t for _, t in
                                             self.cpu_history)]
        return smoothed

    def decide(self, zone, readings, raw=None):
        """Return (pwm, reason, faults) for one zone, never below its
        floor so the fan cannot stall. Critical limits are checked against
        the raw (unsmoothed) readings."""
        pwm, reason, faults = self._decide(zone, readings, raw or readings)
        return max(pwm, zone.floor), reason, faults

    def _decide(self, zone, readings, raw):
        src = self.curve.critical(raw)
        if src:
            return PWM_MAX, "critical %s temperature" % src, []
        if self.settings.fanmode == "manual":
            return self.settings.manualpwm, "manual", []
        if not any(temps for src, temps in readings.items()
                   if self.settings.use.get(src)):
            return PWM_MAX, "no temperature sensors", \
                ["no temperature sensors"]
        pwm, reason = self.curve.next_pwm(zone.pwm, readings, zone.hold)
        return pwm, reason, []

    def apply(self, zone, pwm, reason, setter, now, readback=None):
        """Write the PWM when changed, when the hardware no longer reports
        what was written (readback), or periodically; return faults."""
        drifted = zone.pwm is not None and readback is not None and \
            abs(readback - zone.pwm) > PWM_READBACK_TOLERANCE
        if drifted:
            log.warning("%s PWM reads %d, expected %d: rewriting", zone.name,
                        readback, zone.pwm)
        elif pwm == zone.pwm and now - zone.last_write < PWM_REFRESH_SECONDS:
            return []
        try:
            setter(pwm)
        except OSError as e:
            log.error("Failed to set %s PWM: %s", zone.name, e)
            return ["cannot set %s fan speed" % zone.name]
        if pwm != zone.pwm:
            log.info("%s PWM %s -> %d (%s)", zone.name, zone.pwm, pwm,
                     reason)
        zone.pwm = pwm
        zone.last_write = now
        return []

    def step(self, now=None):
        now = time.monotonic() if now is None else now
        readings, rows = collect(self.hw, self.settings, self.disks, now)
        pwm, reason, faults = self.decide(
            self.chassis, self.smooth_cpu(readings, now), readings)
        faults += self.apply(self.chassis, pwm, reason, self.hw.set_pwm, now,
                             self.hw.read_pwm())
        faults += self.check_fans(self.hw.fans(), self.chassis.pwm)

        cards = []
        for card, temps, card_rows in collect_cards(self.hw):
            rows += card_rows
            if not self.settings.use["qm2"]:
                # Leave the card fan to its PIC; just report it.
                cards.append((card, card.read_pwm()))
                continue
            zone = self.cards.setdefault(card.name,
                                         Zone(card.name, MIN_PWM_QM2))
            card_pwm, card_reason, card_faults = self.decide(
                zone, {"qm2": temps})
            faults += ["%s: %s" % (card.name, f) for f in card_faults]
            faults += self.apply(zone, card_pwm, card_reason, card.set_pwm,
                                 now, card.read_pwm())
            faults += self.check_fans([card.fan()], zone.pwm)
            cards.append((card, zone.pwm))

        errors = self.disk_errors(now)
        if self.disk_leds:
            self.disk_leds.update(errors)
        storage = self.storage[2:]
        local = time.localtime()
        brightness = panel_brightness(self.settings,
                                      local.tm_hour * 60 + local.tm_min)
        if brightness != self.brightness:
            set_panel_brightness(brightness)
            self.brightness = brightness
        if self.settings.ledstatus:
            self.led.set(status_led_state(faults, storage[0]))
        self.alarms(faults, storage[0], now)
        self.notifier.update(hardware_problems(faults, reason, errors,
                                               storage), now)
        status = build_status(self.hw, rows, self.chassis.pwm,
                              self.settings.fanmode, reason, faults, True,
                              cards, storage,
                              self.disk_leds.snapshot() if self.disk_leds
                              else ())
        write_status(status)
        return status

    FAN_ALARM_SECONDS = 300  # QTS: 3 long beeps every 5 minutes

    def alarms(self, faults, storage_state, now):
        """QTS beeps: a stopped fan every FAN_ALARM_SECONDS; storage turning
        degraded, rebuilding, failed or full (not the state at start)."""
        if any("not spinning" in f for f in faults):
            if self.fan_beep is None or \
                    now - self.fan_beep >= self.FAN_ALARM_SECONDS:
                self.beeper.beep("fan-failure")
                self.fan_beep = now
        else:
            self.fan_beep = None
        if self.storage_seen is not None and storage_state != "ok" and \
                storage_state != self.storage_seen:
            self.beeper.beep("storage")
        self.storage_seen = storage_state

    def disk_errors(self, now):
        """Disks to show red: failed S.M.A.R.T. or faulted in an array.
        Pools and arrays are checked at the disk polling interval."""
        if self.storage[0] is None or \
                now - self.storage[0] >= self.settings.diskinterval:
            self.storage = (now,) + storage_health(self.settings.volumefull)
        return (self.disks.failed if self.disks else set()) | \
            self.storage[1]

    def run(self):
        if not self.hw.present():
            log.error("The %s hwmon device was not found; is the driver "
                      "loaded?", DRIVER)
            return 1
        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(sig, lambda *_: self.stop.set())
        if self.settings.ledstatus:
            self.led.set("starting")
        if not self.settings.use["qm2"]:
            # The user prefers the cards to manage their own fans.
            for card in self.hw.qm2_cards():
                try:
                    card.restore_default()
                except OSError as e:
                    log.warning("Cannot hand %s fan back to the card: %s",
                                card.name, e)
        log.info("Started (mode=%s, interval=%ds, QM2 cards: %s)",
                 self.settings.fanmode, self.settings.interval,
                 ", ".join(c.name for c in self.hw.qm2_cards()) or "none")
        if self.disk_leds:
            self.disk_leds.start()
        self.buttons.start()
        if (uptime() or 1e9) < 300:  # booting, not a restart on Apply
            self.beeper.beep("startup")
        while not self.stop.is_set():
            try:
                self.step()
            except Exception:  # Never leave the fan at a low speed.
                log.exception("Control loop failed, fans to full speed")
                failsafe(qm2=self.settings.use["qm2"])
            self.stop.wait(self.settings.interval)
        log.info("Stopping")
        self.buttons.finish()
        if self.disk_leds:
            self.disk_leds.finish()
        return 0


def failsafe(service_result=None, qm2=None):
    """Drive the chassis fans to full speed (qnap8528 has no automatic mode
    to return to); flag the status LED on failure.

    QM2 card fans the plugin controls (useqm2) go back to the card's own
    controller after a clean stop (service_result "success"), and to full
    speed after a failure or when run by hand. With useqm2 off the plugin
    never touches them.
    """
    if qm2 is None:
        qm2 = load_settings_or_default().use["qm2"]
    clean = service_result == "success"
    hw = Hardware()
    try:
        hw.set_pwm(PWM_MAX)
    except OSError as e:
        log.error("Failsafe could not set PWM: %s", e)
    for card in hw.qm2_cards() if qm2 else []:
        try:
            if clean:
                card.restore_default()
            else:
                card.set_pwm(PWM_MAX)
        except OSError as e:
            log.error("Failsafe could not set %s fan: %s", card.name, e)
    for led in glob.glob(sysfs("class", "leds", DRIVER + "::hdd*")) + \
            glob.glob(sysfs("class", "leds", "qm2-*:green:slot*")):
        if "[timer]" in (read(os.path.join(led, "trigger")) or ""):
            try:
                write(os.path.join(led, "trigger"), "none")
            except OSError:
                pass
    if service_result not in (None, "", "success"):
        StatusLed().set("warning")
        if load_settings_or_default().notify:
            send_mail("QNAP hardware on %s: qnapd stopped unexpectedly"
                      % socket.gethostname(),
                      "qnapd exited (%s). The chassis fans are at full speed "
                      "until systemd restarts it. See `journalctl -u qnapd`."
                      % service_result)
    return 0


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------

def load_settings_or_default():
    try:
        return Settings.load()
    except (OSError, ValueError):
        return Settings()


def cmd_run(args):
    return Daemon(Settings.load(args.config)).run()


def read_status(max_age):
    """The daemon's status file, or None if missing or older than max_age."""
    try:
        with open(STATUS_FILE) as f:
            status = json.load(f)
    except (OSError, ValueError):
        return None
    if time.time() - status.get("timestamp", 0) > max_age:
        return None
    return status


def collectd_values(status):
    """[(type-instance, value)] for collectd from a status dict: the hottest
    temperature per source, and every fan speed and duty."""
    hottest = {}
    values = []
    for row in status["rows"]:
        value = row["value"]
        if not isinstance(value, (int, float)):
            continue
        if row["type"] == "temperature":
            hottest[row["source"]] = max(value,
                                         hottest.get(row["source"], value))
        elif row["type"] in ("fan", "pwm"):
            kind = "fanspeed" if row["type"] == "fan" else "percent"
            name = re.sub(r"[^A-Za-z0-9_]", "_", row["name"])
            values.append(("%s-%s" % (kind, name), value))
    return [("temperature-" + src, t)
            for src, t in sorted(hottest.items())] + values


def cmd_collectd(args):
    """Run under collectd's exec plugin (as nobody); only reads the status
    file, so it never touches the hardware or wakes disks."""
    host = os.environ.get("COLLECTD_HOSTNAME", "localhost")
    interval = max(1, int(float(os.environ.get("COLLECTD_INTERVAL", "60"))))
    try:
        while True:
            # Report nothing while the daemon is stopped: a gap, not a lie.
            status = read_status(max(30, 3 * interval))
            for ident, value in collectd_values(status) if status else []:
                print('PUTVAL "%s/exec-qnap/%s" interval=%d N:%s' %
                      (host, ident, interval, value), flush=True)
            time.sleep(interval)
    except (BrokenPipeError, KeyboardInterrupt):
        return 0


def cmd_status(args):
    settings = load_settings_or_default()
    status = read_status(max(30, 3 * settings.interval))
    if status is None:
        # Daemon not running: read live, without waking disks via smartctl.
        hw = Hardware()
        _, rows = collect(hw, settings)
        cards = []
        for card, _, card_rows in collect_cards(hw):
            rows += card_rows
            cards.append((card, card.read_pwm()))
        status = build_status(hw, rows, hw.read_pwm(), settings.fanmode,
                              None, [], False, cards)
    if args.json:
        print(json.dumps(status))
    else:
        for row in status["rows"]:
            print("%-12s %-20s %s %s" % (row["type"], row["label"],
                                         row["value"], row["unit"]))
    return 0


def detected_model():
    """The model qnap8528 matched at load time, from the kernel log."""
    for cmd in KERNEL_LOG_COMMANDS:
        try:
            out = subprocess.run(cmd, capture_output=True, text=True,
                                 timeout=10).stdout
        except (OSError, subprocess.SubprocessError):
            continue
        found = re.findall(r"qnap8528.*device model is (\S+)", out)
        if found:
            return found[-1]
    return None


def identity():
    """Model, serial number and board data, cached for the boot."""
    try:
        with open(IDENTITY_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        pass
    vpd = sysfs("devices", "platform", DRIVER, "vpd")
    ident = {
        "model": detected_model(),
        "serial": read(os.path.join(vpd, "enclosure_serial")),
        "nickname": read(os.path.join(vpd, "enclosure_nickname")),
        "mainboard_model": read(os.path.join(vpd, "mainboard_model")),
        "backplane_model": read(os.path.join(vpd, "backplane_model")),
        # "2021-08-13 08:49:00"
        "manufactured": (read(os.path.join(vpd, "mainboard_date")) or
                         "")[:10] or None,
    }
    if ident["serial"]:  # Only cache what the driver actually returned.
        try:
            with open(IDENTITY_FILE, "w") as f:
                json.dump(ident, f)
        except OSError:
            pass
    return ident


def header_packages(release):
    """Headers for this kernel plus the metapackage that brings them for
    future kernels of the same line, so DKMS can rebuild the drivers."""
    pve = re.match(r"^(\d+)\.(\d+)\.\S*-pve$", release)
    if pve:
        return ["proxmox-headers-" + release,
                "proxmox-headers-%s.%s" % pve.groups()]
    # Debian: 6.12.48+deb13-amd64 / 6.1.0-18-cloud-amd64 -> amd64 / cloud-amd64
    flavour = re.sub(r"^\d+-", "", release.split("-", 1)[-1])
    return ["linux-headers-" + release, "linux-headers-" + flavour]


def driver_packages():
    """The driver packages shipped with the plugin, and the installed
    version of each (None when not installed)."""
    result = []
    for path in sorted(glob.glob(os.path.join(DRIVERS_DIR,
                                              "*-dkms_*_all.deb"))):
        package, version = os.path.basename(path).split("_")[:2]
        status = command_output(["dpkg-query", "-W", "-f",
                                 "${db:Status-Abbrev}${Version}", package])
        result.append({"package": package, "path": path, "bundled": version,
                       "installed": status[3:].strip()
                       if status.startswith("ii") else None})
    return result


def cmd_info(args):
    ec_dir = sysfs("devices", "platform", DRIVER)
    dmi = sysfs("class", "dmi", "id")
    info = identity()
    info.update({
        "loaded": os.path.isdir(sysfs("module", DRIVER)),
        "hwmon": Hardware().present(),
        "fw_version": read(os.path.join(ec_dir, "ec", "fw_version")),
        "cpld_version": read(os.path.join(ec_dir, "ec", "cpld_version")),
        "power_recovery": read(os.path.join(ec_dir, "ec", "power_recovery")),
        "eup_mode": read(os.path.join(ec_dir, "ec", "eup_mode")),
        "bios_version": read(os.path.join(dmi, "bios_version")),
        "bios_date": read(os.path.join(dmi, "bios_date")),
        "reboot_efi": "reboot=efi" in (read(
            os.environ.get("QNAPD_CMDLINE", "/proc/cmdline")) or "").split(),
        "leds": sorted(os.path.basename(p)[len(DRIVER) + 2:] for p in
                       glob.glob(sysfs("class", "leds", DRIVER + "::*"))),
        "qm2_loaded": os.path.isdir(sysfs("module", "qm2mod")),
        "kernel": os.uname().release,
        "headers": os.path.isdir(os.path.join(MODULES_DIR, os.uname().release,
                                              "build")),
        "header_packages": header_packages(os.uname().release),
        "driver_packages": driver_packages(),
        "qm2": [{"name": card.name, "model": card.attr("model"),
                 "serial": card.attr("serial"),
                 "pic_version": card.attr("pic_version"),
                 "pci": card.pci_path(),
                 "leds": [os.path.basename(p) for p in card.leds()]}
                for card in Hardware.qm2_cards()],
    })
    print(json.dumps(info) if args.json else
          "\n".join("%s: %s" % kv for kv in info.items()))
    return 0


def cmd_failsafe(args):
    return failsafe(os.environ.get("SERVICE_RESULT"))


def main(argv=None):
    parser = argparse.ArgumentParser(prog="qnapd", description=__doc__,
                                     formatter_class=argparse.
                                     RawDescriptionHelpFormatter)
    parser.add_argument("-d", "--debug", action="store_true")
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("run")
    p.add_argument("-c", "--config", default=None)
    p.set_defaults(func=cmd_run)
    for name, func in (("status", cmd_status), ("info", cmd_info)):
        p = sub.add_parser(name)
        p.add_argument("--json", action="store_true")
        p.set_defaults(func=func)
    sub.add_parser("failsafe").set_defaults(func=cmd_failsafe)
    sub.add_parser("collectd").set_defaults(func=cmd_collectd)
    args = parser.parse_args(argv)
    logging.basicConfig(level=logging.DEBUG if args.debug else logging.INFO,
                        format="%(levelname)s: %(message)s")
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
