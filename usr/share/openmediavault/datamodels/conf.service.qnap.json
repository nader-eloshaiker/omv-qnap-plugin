{
	"type": "config",
	"id": "conf.service.qnap",
	"title": "QNAP hardware",
	"queryinfo": {
		"xpath": ".//services/qnap",
		"iterable": false
	},
	"properties": {
		"enable": {
			"type": "boolean",
			"default": false
		},
		"interval": {
			"type": "integer",
			"minimum": 2,
			"maximum": 120,
			"default": 10
		},
		"fanmode": {
			"type": "string",
			"enum": ["quiet", "normal", "performance", "custom", "manual"],
			"default": "normal"
		},
		"manualpwm": {
			"type": "integer",
			"minimum": 0,
			"maximum": 255,
			"default": 160
		},
		"minpwm": {
			"type": "integer",
			"minimum": 0,
			"maximum": 255,
			"default": 64
		},
		"maxpwm": {
			"type": "integer",
			"minimum": 0,
			"maximum": 255,
			"default": 255
		},
		"hysteresis": {
			"type": "integer",
			"minimum": 0,
			"maximum": 15,
			"default": 3
		},
		"usecpu": {
			"type": "boolean",
			"default": true
		},
		"cpulow": {
			"type": "integer",
			"minimum": 0,
			"maximum": 110,
			"default": 55
		},
		"cpuhigh": {
			"type": "integer",
			"minimum": 0,
			"maximum": 110,
			"default": 85
		},
		"usesystem": {
			"type": "boolean",
			"default": true
		},
		"syslow": {
			"type": "integer",
			"minimum": 0,
			"maximum": 110,
			"default": 30
		},
		"syshigh": {
			"type": "integer",
			"minimum": 0,
			"maximum": 110,
			"default": 45
		},
		"usedisk": {
			"type": "boolean",
			"default": true
		},
		"disklow": {
			"type": "integer",
			"minimum": 0,
			"maximum": 110,
			"default": 38
		},
		"diskhigh": {
			"type": "integer",
			"minimum": 0,
			"maximum": 110,
			"default": 48
		},
		"diskinterval": {
			"type": "integer",
			"minimum": 10,
			"maximum": 3600,
			"default": 60
		},
		"usenvme": {
			"type": "boolean",
			"default": true
		},
		"nvmelow": {
			"type": "integer",
			"minimum": 0,
			"maximum": 110,
			"default": 45
		},
		"nvmehigh": {
			"type": "integer",
			"minimum": 0,
			"maximum": 110,
			"default": 65
		},
		"useqm2": {
			"type": "boolean",
			"default": true
		},
		"ledstatus": {
			"type": "boolean",
			"default": true
		},
		"leddisk": {
			"type": "boolean",
			"default": true
		},
		"ledbrightness": {
			"type": "integer",
			"minimum": 0,
			"maximum": 100,
			"default": 100
		},
		"volumefull": {
			"type": "integer",
			"minimum": 50,
			"maximum": 100,
			"default": 95
		},
		"lednight": {
			"type": "boolean",
			"default": false
		},
		"lednightstart": {
			"type": "string",
			"pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
			"default": "22:00"
		},
		"lednightend": {
			"type": "string",
			"pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
			"default": "07:00"
		},
		"lednightbrightness": {
			"type": "integer",
			"minimum": 0,
			"maximum": 100,
			"default": 10
		},
		"beep": {
			"type": "boolean",
			"default": false
		},
		"usbcopytask": {
			"type": "string",
			"pattern": "^([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})?$",
			"default": ""
		},
		"resettask": {
			"type": "string",
			"pattern": "^([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})?$",
			"default": ""
		},
		"powerrecovery": {
			"type": "string",
			"enum": ["unchanged", "off", "on", "last"],
			"default": "unchanged"
		},
		"eupmode": {
			"type": "string",
			"enum": ["unchanged", "off", "on"],
			"default": "unchanged"
		},
		"loadmodule": {
			"type": "boolean",
			"default": false
		},
		"skiphwcheck": {
			"type": "boolean",
			"default": false
		},
		"loadqm2": {
			"type": "boolean",
			"default": false
		},
		"rebootefi": {
			"type": "boolean",
			"default": true
		}
	}
}
