[
	{
		"type": "rpc",
		"id": "rpc.qnap.setfansettings",
		"params": {
			"type": "object",
			"properties": {
				"enable": { "type": "boolean", "required": true },
				"interval": { "type": "integer", "minimum": 2, "maximum": 120, "required": true },
				"fanmode": { "type": "string", "enum": ["quiet", "normal", "performance", "custom", "manual"], "required": true },
				"manualspeed": { "type": "integer", "minimum": 0, "maximum": 100, "required": true },
				"minspeed": { "type": "integer", "minimum": 0, "maximum": 100, "required": true },
				"maxspeed": { "type": "integer", "minimum": 0, "maximum": 100, "required": true },
				"hysteresis": { "type": "integer", "minimum": 0, "maximum": 15, "required": true },
				"usecpu": { "type": "boolean", "required": true },
				"cpulow": { "type": "integer", "minimum": 0, "maximum": 110, "required": true },
				"cpuhigh": { "type": "integer", "minimum": 0, "maximum": 110, "required": true },
				"usesystem": { "type": "boolean", "required": true },
				"syslow": { "type": "integer", "minimum": 0, "maximum": 110, "required": true },
				"syshigh": { "type": "integer", "minimum": 0, "maximum": 110, "required": true },
				"usedisk": { "type": "boolean", "required": true },
				"disklow": { "type": "integer", "minimum": 0, "maximum": 110, "required": true },
				"diskhigh": { "type": "integer", "minimum": 0, "maximum": 110, "required": true },
				"diskinterval": { "type": "integer", "minimum": 10, "maximum": 3600, "required": true },
				"usenvme": { "type": "boolean", "required": true },
				"nvmelow": { "type": "integer", "minimum": 0, "maximum": 110, "required": true },
				"nvmehigh": { "type": "integer", "minimum": 0, "maximum": 110, "required": true },
				"useqm2": { "type": "boolean", "required": true }
			}
		}
	},
	{
		"type": "rpc",
		"id": "rpc.qnap.setfrontpanelsettings",
		"params": {
			"type": "object",
			"properties": {
				"ledstatus": { "type": "boolean", "required": true },
				"leddisk": { "type": "boolean", "required": true },
				"ledbrightness": { "type": "integer", "minimum": 0, "maximum": 100, "required": true },
				"volumefull": { "type": "integer", "minimum": 50, "maximum": 100, "required": true },
				"lednight": { "type": "boolean", "required": true },
				"lednightstart": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "required": true },
				"lednightend": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "required": true },
				"lednightbrightness": { "type": "integer", "minimum": 0, "maximum": 100, "required": true }
			}
		}
	},
	{
		"type": "rpc",
		"id": "rpc.qnap.locate",
		"params": {
			"type": "object",
			"properties": {
				"id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "required": true },
				"enable": { "type": "boolean", "required": true }
			}
		}
	},
	{
		"type": "rpc",
		"id": "rpc.qnap.setpowersettings",
		"params": {
			"type": "object",
			"properties": {
				"powerrecovery": { "type": "string", "enum": ["unchanged", "off", "on", "last"], "required": true },
				"eupmode": { "type": "string", "enum": ["unchanged", "off", "on"], "required": true },
				"rebootefi": { "type": "boolean", "required": true }
			}
		}
	},
	{
		"type": "rpc",
		"id": "rpc.qnap.setbuttonsettings",
		"params": {
			"type": "object",
			"properties": {
				"beep": { "type": "boolean", "required": true },
				"usbcopytask": { "type": "string", "pattern": "^([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})?$", "required": true },
				"resettask": { "type": "string", "pattern": "^([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})?$", "required": true }
			}
		}
	},
	{
		"type": "rpc",
		"id": "rpc.qnap.setdriversettings",
		"params": {
			"type": "object",
			"properties": {
				"loadmodule": { "type": "boolean", "required": true },
				"skiphwcheck": { "type": "boolean", "required": true },
				"loadqm2": { "type": "boolean", "required": true }
			}
		}
	}
]
